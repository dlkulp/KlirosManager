{
  "name": "frontend",
  "version": "0.0.1",
  "private": true,
  "description": "Kliros Manager Frontend",
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-app-vite",
    "quasar-cli",
    "vite",
    "vue",
    "vuejs"
  ],
  "author": "Damian Kulp <damiankulp@gmail.com>",
  "type": "module",
  "scripts": {
    "lint": "oxfmt && oxlint --fix",
    "lint:check": "oxfmt --check && oxlint",
    "dev": "quasar dev",
    "build": "quasar build",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "quasar prepare --silent",
	"prod": "quasar build -m pwa"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "quasar": "^2.35.4",
    "vue": "^3.5.22",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@quasar/app-vite": "^3.10.4",
    "@types/node": "^22.19.11",
    "autoprefixer": "^10.4.27",
    "oxfmt": "^0.x",
    "oxlint": "^1.x",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.5.8",
    "typescript": "^6.0.0",
    "vue-tsc": "^3.3.3"
  },
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  },
  "productName": "Kliros Manager"
}
